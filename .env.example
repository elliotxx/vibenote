# Untracked local secrets for a signed macOS release.
# Copy the values into your shell. Do not commit a filled-in .env file.
#
# Unsigned local build (default, no secrets):
#   npm run release:mac
#
# Signed and notarized build:
#   npm run release:mac:signed

# Developer ID Application certificate, exported as a .p12.
# Use a filesystem path locally, or the base64 contents of the .p12 in CI.
CSC_LINK=
CSC_KEY_PASSWORD=

# Optional keychain identity name when CSC_LINK is not used.
# Do not include the "Developer ID Application:" prefix.
CSC_NAME=

# Notarization option 1: Apple ID app-specific password.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Notarization option 2: App Store Connect API key.
# APPLE_API_KEY is a filesystem path. In GitHub Actions, store the key
# contents in APPLE_API_KEY_P8 and let the release workflow materialize it.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_KEY_P8=

# Notarization option 3: a notarytool keychain profile already on the Mac.
APPLE_KEYCHAIN=
APPLE_KEYCHAIN_PROFILE=

# Generic updater feed. Recommended for GitHub Releases:
#   https://github.com/elliotxx/vibenote/releases/latest/download
# Use "disabled" to turn the feed off. Leave empty for unsigned local builds.
VIBENOTE_UPDATE_FEED_URL=

# Set to 0 only when experimenting with a signature before notarization.
VIBENOTE_MAC_NOTARIZE=

# Runtime escape hatch for packaged builds.
VIBENOTE_DISABLE_AUTO_UPDATE=
